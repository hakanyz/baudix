#!/bin/sh
set -e

case "$1" in
    configure)
        # Reload udev rules and trigger permissions immediately for connected USB devices
        if command -v udevadm >/dev/null 2>&1; then
            udevadm control --reload-rules || true
            udevadm trigger --subsystem-match=tty || udevadm trigger || true
        fi

        # Add the installing user to the dialout group if applicable
        if [ -n "$SUDO_USER" ] && [ "$SUDO_USER" != "root" ]; then
            usermod -aG dialout "$SUDO_USER" 2>/dev/null || true
        fi
    ;;
esac

exit 0
