/* General Application Style - Baudix Professional Theme */
QWidget {
    background-color: #282c34;
    color: #abb2bf;
    font-family: "Segoe UI", "Helvetica Neue", sans-serif;
    font-size: 13px;
}

/* Group Boxes for Tools panel sections */
QGroupBox {
    border: 1px solid #3e4452;
    border-radius: 4px;
    margin-top: 10px;
    padding-top: 6px;
}
QGroupBox::title {
    subcontrol-origin: margin;
    subcontrol-position: top left;
    left: 8px;
    top: -1px;
    padding: 0 4px;
    color: #61afef;
    font-weight: bold;
}

/* Main Window and Docks */
QMainWindow::separator {
    background: #181a1f;
    width: 2px;
    height: 2px;
}

QDockWidget {
    font-weight: bold;
    color: #abb2bf;
}

QDockWidget::title {
    background-color: #21252b;
    padding: 6px;
    margin-top: 2px;
    border-bottom: 1px solid #181a1f;
}

QWidget#dockContent {
    background-color: #21252b;
}

/* Inputs and Combos */
QLineEdit, QComboBox, QPlainTextEdit, QSpinBox {
    background-color: #1e2227;
    border: 1px solid #181a1f;
    border-radius: 4px;
    padding: 4px;
    selection-background-color: #61afef;
    color: #abb2bf;
}

QLineEdit:focus, QComboBox:focus, QPlainTextEdit:focus, QSpinBox:focus {
    border: 1px solid #61afef;
}

QComboBox::drop-down {
    subcontrol-origin: padding;
    subcontrol-position: top right;
    width: 20px;
    border-left: 1px solid #181a1f;
}

QComboBox QAbstractItemView {
    background-color: #1e2227;
    border: 1px solid #181a1f;
    selection-background-color: #61afef;
}

/* Buttons */
QPushButton {
    background-color: #3e4451;
    border: 1px solid #282c34;
    border-radius: 5px;
    padding: 6px 14px;
    color: #abb2bf;
    font-weight: normal;
}

QPushButton:hover {
    background-color: #4b5363;
    color: #ffffff;
    border: 1px solid #5c6370;
}

QPushButton:pressed {
    background-color: #2c313a;
    border-color: #181a1f;
}

/* Segmented Control Buttons (like ASCII / HEX / Both) */
QPushButton:checked {
    background-color: #61afef;
    border: 1px solid #4d8fcc;
    color: #ffffff;
}

/* Toggle style buttons (Auto Reconnect, Timestamp) - same as regular checkable buttons */
/* No special rule needed - uses QPushButton:checked which is blue already */

/* Special styling for the Send button - same base, slightly accented */
QPushButton#sendButton {
    background-color: #2c4a6e;
    border: 1px solid #61afef;
    color: #61afef;
    font-weight: bold;
}

QPushButton#sendButton:hover {
    background-color: #3a5f8a;
    color: #ffffff;
}

QPushButton#sendButton:pressed {
    background-color: #61afef;
    color: #282c34;
}

/* Clear Terminal Button */
QPushButton#clearTerminalBtn {
    background-color: transparent;
    border: 1px solid #e06c75;
    color: #e06c75;
}
QPushButton#clearTerminalBtn:hover {
    background-color: #e06c75;
    color: #282c34;
}

/* Small icon buttons (e.g. Search Next/Prev) */
QPushButton#iconBtn {
    padding: 2px 0px;
    font-size: 14px;
}

/* Connect / Disconnect Buttons in Connection Dock */
QPushButton#connectBtn {
    background-color: #3a3f4b;
    color: #98c379;
    font-weight: bold;
    border-radius: 4px;
    padding: 6px 10px;
}
QPushButton#connectBtn:hover { background-color: #4b5363; }

QPushButton#disconnectBtn {
    background-color: #3a3f4b;
    color: #e06c75;
    font-weight: bold;
    border-radius: 4px;
    padding: 6px 10px;
}
QPushButton#disconnectBtn:hover { background-color: #4b5363; }

/* iOS Style Toggle Checkbox */
QCheckBox::indicator {
    width: 36px;
    height: 20px;
    border-radius: 10px;
}
QCheckBox::indicator:unchecked {
    background-color: #3a3f4b;
    border: 1px solid #181a1f;
}
QCheckBox::indicator:checked {
    background-color: #61afef;
    border: 1px solid #4d8fcc;
}

/* Terminal Screen */
QTabWidget::pane {
    border: 1px solid #181a1f;
    background: #21252b;
}
QTabBar::tab {
    background: #282c34;
    border: 1px solid #181a1f;
    padding: 6px 12px;
    color: #8a919e;
}
QTabBar::tab:selected {
    background: #21252b;
    border-bottom-color: #21252b; /* Hide bottom border to merge with pane */
    color: #abb2bf;
}

QTextEdit#terminalOutput {
    background-color: #1e2227;
    color: #abb2bf;
    font-family: "Consolas", "Courier New", monospace;
    font-size: 14px;
    border: 1px solid #181a1f;
    border-radius: 4px;
}

/* StatusBar */
QStatusBar {
    background-color: #21252b;
    border-top: 1px solid #181a1f;
}

/* Macros list */
QListWidget {
    background-color: #1e2227;
    border: 1px solid #3e3e42;
    border-radius: 4px;
    color: #abb2bf;
    outline: none;
}

QListWidget::item {
    padding: 4px 6px;
    border-radius: 3px;
    min-height: 22px;
}

QListWidget QLineEdit {
    background-color: #1e2227;
    color: #abb2bf;
    border: 1px solid #61afef;
    padding: 2px;
    min-height: 20px;
}

QListWidget::item:hover {
    background-color: #3a3f4b;
}

QListWidget::item:selected {
    background-color: #007acc;
    color: #ffffff;
}
