/* General Application Style - Baudix Professional Theme */
QWidget {
    background-color: #282c34;
    color: #abb2bf;
    font-family: "Segoe UI", "Helvetica Neue", sans-serif;
    font-size: 13px;
}

/* Main Window and Docks */
QMainWindow::separator {
    background: #181a1f;
    width: 2px;
    height: 2px;
}

QDockWidget {
    font-weight: bold;
    color: #abb2bf;
}

QDockWidget::title {
    background-color: #21252b;
    padding: 6px;
    margin-top: 2px;
    border-bottom: 1px solid #181a1f;
}

QWidget#dockContent {
    background-color: #21252b;
}

/* Inputs and Combos */
QLineEdit, QComboBox, QPlainTextEdit, QSpinBox {
    background-color: #1e2227;
    border: 1px solid #181a1f;
    border-radius: 4px;
    padding: 4px;
    selection-background-color: #61afef;
    color: #abb2bf;
}

QLineEdit:focus, QComboBox:focus, QPlainTextEdit:focus, QSpinBox:focus {
    border: 1px solid #61afef;
}

QComboBox::drop-down {
    subcontrol-origin: padding;
    subcontrol-position: top right;
    width: 20px;
    border-left: 1px solid #181a1f;
}

QComboBox QAbstractItemView {
    background-color: #1e2227;
    border: 1px solid #181a1f;
    selection-background-color: #61afef;
}

/* Buttons */
QPushButton {
    background-color: #3a3f4b;
    border: 1px solid #181a1f;
    border-radius: 4px;
    padding: 6px 12px;
    color: #abb2bf;
}

QPushButton:hover {
    background-color: #4b5363;
}

QPushButton:pressed {
    background-color: #61afef;
    border-color: #61afef;
    color: #ffffff;
}

/* Segmented Control Buttons (like ASCII / HEX / Both) */
QPushButton:checked {
    background-color: #61afef;
    color: #ffffff;
}

/* Special styling for the Send button */
QPushButton#sendButton {
    background-color: #61afef;
    border: 1px solid #4d8fcc;
    color: white;
    font-weight: bold;
}

QPushButton#sendButton:hover {
    background-color: #79c0ff;
}

QPushButton#sendButton:pressed {
    background-color: #4d8fcc;
}

/* Clear Terminal Button */
QPushButton#clearTerminalBtn {
    background-color: transparent;
    border: 1px solid #e06c75;
    color: #e06c75;
}
QPushButton#clearTerminalBtn:hover {
    background-color: #e06c75;
    color: #282c34;
}

/* Connect / Disconnect Buttons in Toolbar */
QToolButton#connectBtn {
    background-color: #3a3f4b;
    color: #98c379; /* Subtle green text */
    font-weight: bold;
    border-radius: 4px;
    padding: 4px 10px;
}
QToolButton#connectBtn:hover { background-color: #4b5363; }

QToolButton#disconnectBtn {
    background-color: #3a3f4b;
    color: #e06c75; /* Subtle red text */
    font-weight: bold;
    border-radius: 4px;
    padding: 4px 10px;
}
QToolButton#disconnectBtn:hover { background-color: #4b5363; }

/* Toolbar */
QToolBar {
    background-color: #21252b;
    border-bottom: 1px solid #181a1f;
    spacing: 5px;
    padding: 4px;
}

QToolButton {
    background-color: transparent;
    border: none;
    padding: 4px 8px;
    border-radius: 4px;
    color: #abb2bf;
}

QToolButton:hover {
    background-color: #3a3f4b;
}

/* iOS Style Toggle Checkbox */
QCheckBox::indicator {
    width: 36px;
    height: 20px;
    border-radius: 10px;
}
QCheckBox::indicator:unchecked {
    background-color: #3a3f4b;
    border: 1px solid #181a1f;
}
QCheckBox::indicator:checked {
    background-color: #61afef;
    border: 1px solid #4d8fcc;
}

/* Terminal Screen */
QTabWidget::pane {
    border: 1px solid #181a1f;
    background: #21252b;
}
QTabBar::tab {
    background: #282c34;
    border: 1px solid #181a1f;
    padding: 6px 12px;
    color: #8a919e;
}
QTabBar::tab:selected {
    background: #21252b;
    border-bottom-color: #21252b; /* Hide bottom border to merge with pane */
    color: #abb2bf;
}

QTextEdit#terminalOutput {
    background-color: #1e2227;
    color: #abb2bf;
    font-family: "Consolas", "Courier New", monospace;
    font-size: 14px;
    border: 1px solid #181a1f;
    border-radius: 4px;
}

/* StatusBar */
QStatusBar {
    background-color: #21252b;
    border-top: 1px solid #181a1f;
}

/* Macros list */
QListWidget {
    background-color: #1e2227;
    border: 1px solid #3e3e42;
    border-radius: 4px;
    color: #abb2bf;
    outline: none;
}

QListWidget::item {
    padding: 4px 6px;
    border-radius: 3px;
}

QListWidget::item:hover {
    background-color: #3a3f4b;
}

QListWidget::item:selected {
    background-color: #007acc;
    color: #ffffff;
}
